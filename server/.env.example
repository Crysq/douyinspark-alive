# ===== 服务 =====
PORT=8787
APP_ENV=development
ALLOW_ORIGIN=*
JWT_SECRET=change-this-to-a-long-random-string
TOKEN_TTL_HOURS=72

# ===== 数据库 =====
DB_DSN=root:doyinspark@tcp(127.0.0.1:3306)/doyinspark?charset=utf8mb4&parseTime=True&loc=Local

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 签名通道（留空则只读模式：不能登录/发送） =====
SIGN_SERVICE_URL=http://127.0.0.1:9100

# ===== 调度 =====
TICK_SECONDS=20
TZ=Asia/Shanghai
